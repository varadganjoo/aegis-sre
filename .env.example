# Diagnosis model chain. Without keys, Aegis falls back to deterministic rules.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.6-flash,gemini-3.7-flash,gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional: persist learned skills and memory as JSON in this directory (in-memory when unset)
AEGIS_STATE_DIR=
